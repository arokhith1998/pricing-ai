# Normalize line endings to LF in the repo (silences CRLF warnings on Windows).
* text=auto eol=lf
*.csv text eol=lf

# Ingestion stress-test fixtures must keep their EXACT bytes (deliberate CRLF,
# BOM, semicolon delimiters, EU number formats). Treat as binary so git never
# normalizes them, or they stop testing the formats they mimic.
data/synthetic/format-fixtures/*.csv -text
data/synthetic/format-fixtures/*.xlsx binary
# Round-2 adversarial fixtures: cp1252 encoding, NBSP/space thousands, semicolon
# delimiters, CRLF — all deliberate. Keep them byte-exact.
data/synthetic/adversarial-fixtures/*.csv -text
data/synthetic/adversarial-fixtures/*.xlsx binary
# Round-3 judgment fixtures: € symbols, ambiguous dates, formula-injection text.
data/synthetic/round3-fixtures/*.csv -text
