# Copy to .env (gitignored) and fill in. NEVER commit .env or paste keys into chat.

# --- OpenAI cross-model review (tools/oai_review.py) ---
OPENAI_API_KEY=
# Optional: set to a model you have access to (default gpt-4o)
OPENAI_REVIEW_MODEL=gpt-4o

# --- Anthropic / Claude (product LLM layer: narrative, copilot, CSV mapping) ---
ANTHROPIC_API_KEY=
# Cost-effective default for narration; CSV-mapping can use a smaller model.
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- FastAPI service (api/main.py) — set these on the API host (Render) ------
# Shared secret the web tier sends as X-Pricekeel-Key. MUST match
# PRICEKEEL_API_KEY set on the web (Vercel) side. In production, if unset the
# API fail-closes (503) on every non-exempt route.
# PRICEKEEL_API_KEY=match-the-value-set-on-the-web
# Neon POOLED connection string; same value as the web tier. Enables the
# persistent decision log. Unset uses an in-memory fallback (non-durable).
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
# 'dev' relaxes CORS and the auth perimeter for local work. Anything else (or
# unset) is treated as production (fail-closed).
# PRICEKEEL_ENV=dev
# Comma-separated allowed CORS origins in production.
# PRICEKEEL_CORS_ORIGINS=https://www.pricekeel.com
# Optional paid web search for competitor context (opt-in; off by default).
# PERPLEXITY_API_KEY=
# TAVILY_API_KEY=
# Optional: LLM call timeout (seconds) and SSRF host blocklist (comma-separated).
# PRICEKEEL_LLM_TIMEOUT=30
# LEGAL_BLOCKED_HOSTS=
