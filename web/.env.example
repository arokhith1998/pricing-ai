# Pricekeel web environment. Copy to .env.local for local dev (optional).

# Where the FastAPI service lives. Server-side only (never shipped to the
# browser); the UI talks to the API through Next route handlers / server
# components. Local default is http://127.0.0.1:8000 if unset.
PRICEKEEL_API=http://127.0.0.1:8000

# --- Lead store + access codes (production) ---------------------------------
# When set, leads and access codes use Neon/Postgres (run neon/schema.sql
# first). Use the POOLED connection string (the host with "-pooler"). When
# unset, a dev fallback is used: leads are logged to the console and access
# codes come from PRICEKEEL_ACCESS_CODES below. Set the same value on the API.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# Secret used to derive the access cookie. Set a strong value in production.
# PRICEKEEL_SECRET=change-me-to-a-long-random-string

# Dev-only: comma-separated access codes accepted when DATABASE_URL is not set.
# PRICEKEEL_ACCESS_CODES=try-pricekeel,partner-acme

# --- Salesforce External Client App (real OAuth) ---------------------------
# Create an External Client App with Authorization Code + PKCE, callback URL
# below, and scopes `api` plus `refresh_token`. For a sandbox use
# https://test.salesforce.com. Keep all values server-side.
# SALESFORCE_CLIENT_ID=
# SALESFORCE_CLIENT_SECRET=
# SALESFORCE_OAUTH_REDIRECT_URI=http://localhost:3000/api/salesforce/oauth/callback
# SALESFORCE_LOGIN_URL=https://login.salesforce.com
# SALESFORCE_TOKEN_ENCRYPTION_KEY=generate-a-separate-high-entropy-secret
# SALESFORCE_API_VERSION=67.0

# Optional: surfaces a "request access" mailto on the access-code page.
# NEXT_PUBLIC_CONTACT_EMAIL=hello@yourdomain.com

# Render Vercel Web Analytics only after it is enabled for the Vercel project.
# NEXT_PUBLIC_VERCEL_ANALYTICS_ENABLED=true

# Per-recipient link attribution for cold outreach. When true, every page
# renders LinkClickCapture, which reads a `?ref=<token>` query param on
# landing and logs {ref, landing_path, timestamp} to the link_clicks table
# via POST /api/link-click. No IP, user agent, cookie, or free text is
# stored, only the token you chose for that link. Requires the link_clicks
# table (run the latest neon/schema.sql) and DATABASE_URL set, or hits are
# only logged to server memory locally. Before enabling in production,
# update the "What we collect" section of /privacy: today it discloses UTM
# capture only when a visitor submits the lead form, not an anonymous
# landing ping. Link format to use in outreach: pricekeel.com/?ref=company-slug
# (a short campaign/company token only, never a name or email).
# NEXT_PUBLIC_LINK_TRACKING_ENABLED=true

# --- API auth (REQUIRED in production) --------------------------------------
# Shared secret the web tier sends to FastAPI as X-Pricekeel-Key. MUST match
# PRICEKEEL_API_KEY on the API (Render) exactly, or every backend call 401s.
# No default: unset in prod means the diagnostic/ask/copilot flows are broken.
# PRICEKEEL_API_KEY=match-the-value-set-on-the-api

# --- Lead alerts + weekly digest (email) ------------------------------------
# Set at least one of RESEND_API_KEY or LEAD_WEBHOOK_URL in prod, or captured
# leads only log to the server console with no real-time alert.
# RESEND_API_KEY=
# LEAD_WEBHOOK_URL=https://hooks.example.com/lead
# LEAD_NOTIFY_TO=founder@yourdomain.com
# DIGEST_RECIPIENT=founder@yourdomain.com
# Gates the weekly-digest cron; unset disables the cron (safe default).
# CRON_SECRET=generate-a-random-string

# --- Public site + links ----------------------------------------------------
# Absolute origin used to build magic-link URLs in emails. Unset/wrong sends
# broken links. Example: https://www.pricekeel.com
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_FOUNDER_LINKEDIN=https://www.linkedin.com/in/your-handle

# --- Legal pages (/terms, /privacy) -----------------------------------------
# Entity name and jurisdiction show as bracketed placeholders until set (they
# await incorporation). Governing law and venue default to Delaware / New Castle
# County in code, so those are fine unset; override only to change the forum.
# NEXT_PUBLIC_LEGAL_ENTITY=Pricekeel, Inc.
# NEXT_PUBLIC_LEGAL_JURISDICTION=Delaware, USA
# NEXT_PUBLIC_GOVERNING_LAW=Delaware, USA
# NEXT_PUBLIC_LEGAL_VENUE=New Castle County, Delaware
