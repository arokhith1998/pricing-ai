# Pricekeel web environment. Copy to .env.local for local dev (optional).

# Where the FastAPI service lives. Server-side only (never shipped to the
# browser); the UI talks to the API through Next route handlers / server
# components. Local default is http://127.0.0.1:8000 if unset.
PRICEKEEL_API=http://127.0.0.1:8000

# --- Lead store + access codes (production) ---------------------------------
# When set, leads and access codes use Neon/Postgres (run neon/schema.sql
# first). Use the POOLED connection string (the host with "-pooler"). When
# unset, a dev fallback is used: leads are logged to the console and access
# codes come from PRICEKEEL_ACCESS_CODES below. Set the same value on the API.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# Secret used to derive the access cookie. Set a strong value in production.
# PRICEKEEL_SECRET=change-me-to-a-long-random-string

# Dev-only: comma-separated access codes accepted when DATABASE_URL is not set.
# PRICEKEEL_ACCESS_CODES=try-pricekeel,partner-acme

# --- Salesforce External Client App (real OAuth) ---------------------------
# Create an External Client App with Authorization Code + PKCE, callback URL
# below, and scopes `api` plus `refresh_token`. For a sandbox use
# https://test.salesforce.com. Keep all values server-side.
# SALESFORCE_CLIENT_ID=
# SALESFORCE_CLIENT_SECRET=
# SALESFORCE_OAUTH_REDIRECT_URI=http://localhost:3000/api/salesforce/oauth/callback
# SALESFORCE_LOGIN_URL=https://login.salesforce.com
# SALESFORCE_TOKEN_ENCRYPTION_KEY=generate-a-separate-high-entropy-secret
# SALESFORCE_API_VERSION=67.0

# Optional: surfaces a "request access" mailto on the access-code page.
# NEXT_PUBLIC_CONTACT_EMAIL=hello@yourdomain.com
